#!/usr/bin/env bash
set -euo pipefail

find_brew() {
  local brew_path

  if [ -n "${DOTFILES_TEST_BREW_FALLBACK:-}" ]; then
    if [ -x "$DOTFILES_TEST_BREW_FALLBACK" ]; then
      printf '%s\n' "$DOTFILES_TEST_BREW_FALLBACK"
      return 0
    fi
    return 1
  fi

  brew_path=$(command -v brew 2>/dev/null || true)
  if [ -n "$brew_path" ]; then
    printf '%s\n' "$brew_path"
    return 0
  fi

  for brew_path in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
    if [ -x "$brew_path" ]; then
      printf '%s\n' "$brew_path"
      return 0
    fi
  done

  return 1
}

prepend_path() {
  case ":$PATH:" in
  *":$1:"*) ;;
  *) PATH="$1:$PATH" ;;
  esac
  export PATH
}

say_run() {
  local argument

  for argument in "$@"; do
    printf '%q ' "$argument"
  done
  printf '\n'

  if [ "$dry_run" = false ]; then
    "$@"
  fi
}

main() {
  local source_dir os_name brew_bin brew_bin_dir node_prefix

  dry_run=false
  if [ "$#" -gt 1 ]; then
    printf 'usage: dotfiles-bootstrap [--dry-run]\n' >&2
    return 2
  fi
  case "${1:-}" in
  '') ;;
  --dry-run) dry_run=true ;;
  *)
    printf 'usage: dotfiles-bootstrap [--dry-run]\n' >&2
    return 2
    ;;
  esac

  source_dir=${DOTFILES_SOURCE_DIR:-}
  if [ -z "$source_dir" ]; then
    printf 'DOTFILES_SOURCE_DIR must name the chezmoi source directory\n' >&2
    return 2
  fi
  if [ ! -f "$source_dir/Brewfile" ]; then
    printf 'missing bootstrap manifest: %s\n' "$source_dir/Brewfile" >&2
    return 2
  fi
  if [ ! -f "$source_dir/package.json" ]; then
    printf 'missing bootstrap manifest: %s\n' "$source_dir/package.json" >&2
    return 2
  fi

  os_name=${DOTFILES_TEST_OS:-$(uname -s)}
  case "$os_name" in
  Darwin | Linux) ;;
  *)
    printf 'unsupported operating system: %s\n' "$os_name" >&2
    return 1
    ;;
  esac

  brew_bin=$(find_brew || true)
  if [ -z "$brew_bin" ]; then
    if [ "$dry_run" = false ]; then
      printf 'Homebrew is required; install it from https://brew.sh\n' >&2
      return 1
    fi
    brew_bin=brew
  fi

  case "$brew_bin" in
  */*)
    brew_bin_dir=${brew_bin%/*}
    prepend_path "$brew_bin_dir"
    ;;
  esac

  say_run "$brew_bin" bundle --file "$source_dir/Brewfile"
  if [ "$dry_run" = false ] && node_prefix=$("$brew_bin" --prefix node@22 2>/dev/null) && [ -d "$node_prefix/bin" ]; then
    prepend_path "$node_prefix/bin"
  fi
  say_run chezmoi --source "$source_dir" --no-tty init
  say_run install -d -m 700 "$HOME/.local/share/tmux/resurrect"
  say_run env DOTFILES_BOOTSTRAP_EXTERNALS=1 chezmoi --source "$source_dir" --refresh-externals apply
  printf '# pnpm install --frozen-lockfile (in DOTFILES_SOURCE_DIR)\n'
  say_run pnpm --dir "$source_dir" install --frozen-lockfile
  printf '# pnpm rules:generate (in DOTFILES_SOURCE_DIR)\n'
  say_run pnpm --dir "$source_dir" rules:generate
  say_run "$HOME/.local/bin/dotfiles-doctor"
}

main "$@"
