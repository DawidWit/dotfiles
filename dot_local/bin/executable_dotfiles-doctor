#!/usr/bin/env bash
set -euo pipefail

main() {
  local command_name missing

  missing=0
  for command_name in fish ghostty zellij starship atuin bat git chezmoi tmux nvim node pnpm eza rg fd fzf zoxide shellcheck shfmt stylua; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
      printf 'missing: %s\n' "$command_name" >&2
      missing=1
    fi
  done

  if [ -z "${DOTFILES_DOCTOR_SKIP_PATHS:-}" ]; then
    if [ ! -f "$HOME/.config/zellij/plugins/zjstatus.wasm" ]; then
      printf 'missing: %s\n' "$HOME/.config/zellij/plugins/zjstatus.wasm" >&2
      missing=1
    fi
    if [ ! -d "$HOME/.tmux/plugins/tpm" ]; then
      printf 'missing: %s\n' "$HOME/.tmux/plugins/tpm" >&2
      missing=1
    fi
  fi

  if [ "$missing" -ne 0 ]; then
    return 1
  fi

  printf 'doctor: all required checks passed\n'
}

main "$@"
