#!/usr/bin/env bash
# Weather for the tmux status bar, with failure-aware caching.
#
# Replaces dracula's weather_wrapper.sh, which caches whatever its fetch
# returns — including "Weather Unavailable" — for the full 20 minute interval.
# tmux-continuum restores the session at boot before the network is up, so the
# first fetch reliably fails and that error then sits in the status bar for
# twenty minutes.
#
# This keeps the last good reading when a fetch fails and retries after a
# minute instead. Prints nothing if there has never been a good reading.
#
# Self-contained: queries wttr.in directly rather than shelling out to the
# dracula plugin scripts, which live in a bare clone under ~/.tmux and aren't
# tracked anywhere — on a fresh machine that path doesn't exist.

set -u

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/tmux-weather"
DATA="$CACHE_DIR/data"
STAMP="$CACHE_DIR/last-attempt"
OK_INTERVAL=1200  # refresh a good reading every 20 min
RETRY_INTERVAL=60 # retry a failed one after 1 min

# No location in the URL: wttr.in geolocates from the request IP.
# %C = condition, %t = temperature, m = metric.
URL="${TMUX_WEATHER_URL:-https://wttr.in/?format=%C:%t&m}"

# Fetch a reading and print it as "<icon> <temp>", or return nonzero.
fetch() {
  local raw cond temp icon
  # TMUX_WEATHER_RAW is a test seam: skip the network, use a canned response.
  if [ -n "${TMUX_WEATHER_RAW:-}" ]; then
    raw="$TMUX_WEATHER_RAW"
  else
    raw=$(command -p curl -sfL --max-time 5 "$URL" 2>/dev/null) || return 1
  fi

  case "$raw" in
  *:*) ;;
  *) return 1 ;; # not "condition:temp", so not a reading
  esac

  cond=$(printf '%s' "${raw%%:*}" | tr '[:upper:]' '[:lower:]')
  temp="${raw##*:}"
  temp="${temp//+/}"

  # wttr.in answers 200 with prose for an unresolvable location; a reading
  # always carries a digit.
  case "$temp" in
  *[0-9]*) ;;
  *) return 1 ;;
  esac

  # Substring matches, so compound conditions ("light rain shower",
  # "patchy snow possible") land on the right icon.
  case "$cond" in
  *snow* | *sleet* | *blizzard* | *ice*) icon='❄' ;;
  *thunder*) icon='⚡' ;;
  *rain* | *shower* | *drizzle*) icon='☂' ;;
  *cloud* | *overcast* | *fog* | *mist* | *haze*) icon='☁' ;;
  *) icon='☀' ;;
  esac

  printf '%s %s' "$icon" "$temp"
}

mkdir -p "$CACHE_DIR"

now=$(date +%s)
last=$(cat "$STAMP" 2>/dev/null || echo 0)
case "$last" in
'' | *[!0-9]*) last=0 ;;
esac

if ((now - last >= OK_INTERVAL)); then
  if fresh=$(fetch); then
    printf '%s' "$fresh" >"$DATA"
    printf '%s' "$now" >"$STAMP"
  else
    # Back-date the stamp so the next call retries in RETRY_INTERVAL rather
    # than waiting out the whole refresh window.
    printf '%s' "$((now - OK_INTERVAL + RETRY_INTERVAL))" >"$STAMP"
  fi
fi

cat "$DATA" 2>/dev/null
