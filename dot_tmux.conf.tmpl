set -g default-terminal "tmux-256color"
set -as terminal-features ',xterm-256color:RGB'
set -g set-clipboard on
set -g history-limit 100000
set -g renumber-windows on
set -g base-index 1
setw -g pane-base-index 1

unbind r
bind r source-file ~/.tmux.conf
bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5

set -g prefix C-Space
bind C-Space send-prefix

# Forward mouse events to panes, so the wheel scrolls nvim/less directly and
# drops into copy-mode in the shell.
set -g mouse on

# Let nvim and Claude Code see focus gained/lost, so the IDE bridge knows which
# file is active and :checktime can pick up external edits.
set -g focus-events on

# Without this, tmux waits ~500ms after Esc to see if it starts an escape
# sequence, which reads as input lag in nvim.
set -sg escape-time 10

setw -g mode-keys vi
bind-key h select-pane -L
bind-key j select-pane -D
bind-key k select-pane -U

# Cycle wezterm's background preset. wezterm watches the state file this
# writes, so it re-reads its config and repaints; nothing to bind in wezterm.
bind = run-shell '~/.local/bin/wezterm-bg next'
bind + run-shell '~/.local/bin/wezterm-bg prev'

bind n new-window
bind c confirm-before -p 'kill window #W? (y/n)' kill-window
bind q confirm-before -p 'kill session #S? (y/n)' kill-session
bind s display-popup -E -w 80% -h 80% '~/.local/bin/tmux-sessionizer'
bind l choose-tree -Zs
bind Right next-window
bind Left previous-window

set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'

set -g @continuum-restore 'on'
set -g @resurrect-capture-pane-contents 'off'
set -g @resurrect-dir '~/.local/share/tmux/resurrect'
set -g @resurrect-processes 'claude codex'
set -g @continuum-save-interval '60'
set -g status-position top

set -g status-style 'bg=default'
set -g status-left '#[fg={{ .palette.accent }},bg=default,bold] #S '
set -g window-status-current-format '#[fg=#000000,bg={{ .palette.accent }},bold] #I:#W '
set -g window-status-format '#[fg=#888888,bg=default] #I:#W '
# Date/time is written with tmux's own strftime rather than #(date ...): tmux
# runs strftime over the whole status line, so a % inside #() never reaches the
# shell. Polish format — dd.mm, 24h.
set -g status-right '#[fg=#ffb86c,bg=default] #(~/.local/bin/tmux-weather) #[fg={{ .palette.muted }},bg=default]│#[fg=#ffb86c,bg=default]  %d.%m %H:%M'

run '~/.tmux/plugins/tpm/tpm'
