layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zjstatus"
        }
    }

    // Split Focus: a narrow rail sized to what fastfetch actually prints,
    // with btop taking the rest of the ultrawide.
    tab name="Dashboard" focus=true {
        pane split_direction="vertical" {
            pane size="22%" split_direction="horizontal" {
                pane size="60%" name="System" command="/usr/bin/fish" {
                    args "-C" "clear; fastfetch"
                }
                pane size="40%" name="Disks" command="/home/dawid/.config/zellij/bin/disks-watch"
            }
            pane size="78%" name="Monitor" focus=true command="/usr/bin/btop"
        }
    }

    tab name="Agent" {
        pane split_direction="vertical" {
            pane size="68%" name="AI Agent" focus=true
            pane size="32%" split_direction="horizontal" {
                pane size="50%" name="Shell"
                pane size="50%" name="Tests"
            }
        }
    }

    tab name="Runtime" {
        pane split_direction="vertical" {
            pane size="50%" name="Application"
            pane size="50%" name="Logs and Services"
        }
    }

    // Editor: nvim owns most of the ultrawide. Its own explorer and picker
    // cover file navigation, so the side rail stays a plain shell for Git.
    // nvim runs through fish rather than as the pane command, so quitting it
    // leaves a usable prompt instead of zellij's "press Enter to re-run".
    tab name="Editor" {
        pane split_direction="vertical" {
            pane size="72%" name="nvim" focus=true command="/usr/bin/fish" {
                args "-C" "nvim"
            }
            pane size="28%" name="Git and Diff"
        }
    }

    tab name="Scratch" {
        pane name="Scratch Shell"
    }
}
