// Zellij — persistent ultrawide cards
default_shell "/usr/bin/fish"
default_layout "ai-ultrawide"
default_mode "normal"

simplified_ui false
pane_frames true
pane_frame_style "titles"
auto_layout true
mouse_mode true
scroll_buffer_size 50000
copy_clipboard "system"
copy_on_select false
scrollback_editor "/usr/bin/nvim"

// Keep live sessions attachable, but always build a fresh layout after a session exits.
// This prevents an obsolete dashboard snapshot from overriding ai-ultrawide.kdl.
session_serialization false
serialize_pane_viewport false
support_kitty_keyboard_protocol true
support_kitty_graphics_protocol true
osc8_hyperlinks true
show_startup_tips false
show_release_notes false
web_sharing "disabled"

ui {
    pane_frames {
        hide_session_name true
    }
}

theme "deep-indigo"
themes {
    deep-indigo {
        // generated by ~/.config/theme/apply.py -- do not edit by hand
        text_unselected {
            base 221 226 240
            background 30 43 87
            emphasis_0 242 215 154
            emphasis_1 154 219 228
            emphasis_2 188 201 255
            emphasis_3 203 178 245
        }
        text_selected {
            base 30 43 87
            background 239 243 255
            emphasis_0 242 215 154
            emphasis_1 154 219 228
            emphasis_2 188 201 255
            emphasis_3 203 178 245
        }
        ribbon_unselected {
            base 221 226 240
            background 18 26 56
            emphasis_0 242 215 154
            emphasis_1 154 219 228
            emphasis_2 188 201 255
            emphasis_3 203 178 245
        }
        ribbon_selected {
            base 30 43 87
            background 188 201 255
            emphasis_0 242 215 154
            emphasis_1 154 219 228
            emphasis_2 188 201 255
            emphasis_3 203 178 245
        }
        table_title {
            base 188 201 255
            background 30 43 87
            emphasis_0 242 215 154
            emphasis_1 154 219 228
            emphasis_2 188 201 255
            emphasis_3 203 178 245
        }
        table_cell_unselected {
            base 221 226 240
            background 30 43 87
            emphasis_0 242 215 154
            emphasis_1 154 219 228
            emphasis_2 188 201 255
            emphasis_3 203 178 245
        }
        table_cell_selected {
            base 30 43 87
            background 239 243 255
            emphasis_0 242 215 154
            emphasis_1 154 219 228
            emphasis_2 188 201 255
            emphasis_3 203 178 245
        }
        list_unselected {
            base 221 226 240
            background 30 43 87
            emphasis_0 242 215 154
            emphasis_1 154 219 228
            emphasis_2 188 201 255
            emphasis_3 203 178 245
        }
        list_selected {
            base 30 43 87
            background 239 243 255
            emphasis_0 242 215 154
            emphasis_1 154 219 228
            emphasis_2 188 201 255
            emphasis_3 203 178 245
        }
        frame_unselected {
            base 51 64 122
            background 30 43 87
            emphasis_0 242 215 154
            emphasis_1 154 219 228
            emphasis_2 188 201 255
            emphasis_3 203 178 245
        }
        frame_selected {
            base 188 201 255
            background 30 43 87
            emphasis_0 242 215 154
            emphasis_1 154 219 228
            emphasis_2 188 201 255
            emphasis_3 203 178 245
        }
        frame_highlight {
            base 239 243 255
            background 30 43 87
            emphasis_0 242 215 154
            emphasis_1 154 219 228
            emphasis_2 188 201 255
            emphasis_3 203 178 245
        }
        exit_code_success {
            base 127 214 168
            background 30 43 87
            emphasis_0 242 215 154
            emphasis_1 154 219 228
            emphasis_2 188 201 255
            emphasis_3 203 178 245
        }
        exit_code_error {
            base 242 134 143
            background 30 43 87
            emphasis_0 242 215 154
            emphasis_1 154 219 228
            emphasis_2 188 201 255
            emphasis_3 203 178 245
        }
        multiplayer_user_colors {
            player_1 188 201 255
            player_2 169 196 255
            player_3 203 178 245
            player_4 242 215 154
            player_5 154 219 228
            player_6 127 214 168
            player_7 242 134 143
            player_8 201 210 232
            player_9 92 106 155
            player_10 239 243 255
        }
    }
}

// Direct card switching without entering Zellij's Tab mode.
keybinds {
    shared_except "locked" {
        // Predictable pane-only navigation; never cross into another card.
        bind "Alt Left" { MoveFocus "Left"; }
        bind "Alt Down" { MoveFocus "Down"; }
        bind "Alt Up" { MoveFocus "Up"; }
        bind "Alt Right" { MoveFocus "Right"; }

        bind "Ctrl Alt 1" { GoToTab 1; }
        bind "Ctrl Alt 2" { GoToTab 2; }
        bind "Ctrl Alt 3" { GoToTab 3; }
        bind "Ctrl Alt 4" { GoToTab 4; }
        bind "Ctrl Alt 5" { GoToTab 5; }
    }
}

plugins {
    // generated by ~/.config/theme/apply.py -- do not edit by hand
    zjstatus location="file:/home/dawid/.config/zellij/plugins/zjstatus.wasm" {
        format_left  "{mode}{tabs}"
        format_right "#[bg=#121a38,fg=#33407a]#[bg=#33407a,fg=#dde2f0,bold] {session} #[bg=#33407a,fg=#bcc9ff]{datetime}"
        format_space "#[bg=#121a38]"
        format_hide_on_overlength "true"
        format_precedence "lrc"

        mode_normal "#[bg=#33407a,fg=#dde2f0,bold] NORMAL #[bg=#121a38,fg=#33407a]"
        mode_locked "#[bg=#f2868f,fg=#1e2b57,bold] LOCKED #[bg=#121a38,fg=#f2868f]"
        mode_resize "#[bg=#f2d79a,fg=#1e2b57,bold] RESIZE #[bg=#121a38,fg=#f2d79a]"
        mode_pane "#[bg=#f2d79a,fg=#1e2b57,bold] PANE #[bg=#121a38,fg=#f2d79a]"
        mode_tab "#[bg=#f2d79a,fg=#1e2b57,bold] TAB #[bg=#121a38,fg=#f2d79a]"
        mode_scroll "#[bg=#f2d79a,fg=#1e2b57,bold] SCROLL #[bg=#121a38,fg=#f2d79a]"
        mode_search "#[bg=#f2d79a,fg=#1e2b57,bold] SEARCH #[bg=#121a38,fg=#f2d79a]"
        mode_session "#[bg=#f2d79a,fg=#1e2b57,bold] SESSION #[bg=#121a38,fg=#f2d79a]"
        mode_move "#[bg=#f2d79a,fg=#1e2b57,bold] MOVE #[bg=#121a38,fg=#f2d79a]"
        mode_prompt "#[bg=#f2d79a,fg=#1e2b57,bold] PROMPT #[bg=#121a38,fg=#f2d79a]"
        mode_tmux "#[bg=#f2d79a,fg=#1e2b57,bold] TMUX #[bg=#121a38,fg=#f2d79a]"
        mode_enter_search "#[bg=#f2d79a,fg=#1e2b57,bold] ENTER_SEARCH #[bg=#121a38,fg=#f2d79a]"
        mode_rename_tab "#[bg=#f2d79a,fg=#1e2b57,bold] RENAME_TAB #[bg=#121a38,fg=#f2d79a]"
        mode_rename_pane "#[bg=#f2d79a,fg=#1e2b57,bold] RENAME_PANE #[bg=#121a38,fg=#f2d79a]"

        tab_normal "#[bg=#121a38,fg=#8f99bd] {index} {name} "
        tab_active "#[bg=#bcc9ff,fg=#1e2b57,bold] {index} {name} #[bg=#121a38,fg=#bcc9ff]"

        datetime "#[bg=#bcc9ff,fg=#1e2b57,bold] {format} "
        datetime_format "%H:%M"
        datetime_timezone "Europe/Warsaw"
    }
    // end generated
}
