# Ghostty — Deep Indigo programmer workspace
#
# Ghostty 1.3.1 reads BOTH `config` and `config.ghostty` from this
# directory, with `config.ghostty` applied last and winning on conflicts.
# Keep a single file (this one) so there is one source of truth.

# ── Shell and persistent ultrawide workspace ────────────────────────────
command = /usr/bin/fish
# The launcher clears a dead-but-resurrectable zellij session so layout
# edits actually apply, then attaches. See the script for details.
# NOTE: direct: does not run a shell and splits arguments itself, so the
# command here must be a plain executable path with no quoting.
initial-command = direct:/home/dawid/.config/zellij/bin/start-workspace

# ── Typography ──────────────────────────────────────────────────────────
# Tuned for a 3440x1440 display at 100% scale.

# ── Theme and legibility ────────────────────────────────────────────────

# generated by ~/.config/theme/apply.py -- do not edit by hand
font-family = SpaceMono Nerd Font Mono
font-family = JetBrainsMono Nerd Font Mono
font-size = 16
adjust-cell-height = -12.2%
theme = deep-indigo
background-opacity = 0.86
background-opacity-cells = true
background-blur = true
split-divider-color = #33407a
# end generated

# ── Window ──────────────────────────────────────────────────────────────
# zellij draws its own tab bar, so Ghostty's stays hidden.
maximize = true
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
window-padding-color = background
window-show-tab-bar = never
gtk-titlebar-hide-when-maximized = true
gtk-toolbar-style = flat

# ── Developer ergonomics ────────────────────────────────────────────────
scrollback-limit = 100000000
mouse-hide-while-typing = true
unfocused-split-opacity = 0.9
split-preserve-zoom = navigation
resize-overlay = after-first

# ── Shell integration and remote terminal compatibility ─────────────────
shell-integration = detect
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo,path

# ── Notify when a long command finishes outside the focused surface ─────
notify-on-command-finish = unfocused
notify-on-command-finish-after = 10s
notify-on-command-finish-action = no-bell,notify

# ── Clipboard ───────────────────────────────────────────────────────────
# Ctrl+C copies only when a selection exists; otherwise the key reaches
# the running program as SIGINT.
copy-on-select = true
clipboard-read = ask
clipboard-write = allow
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true
keybind = performable:ctrl+c=copy_to_clipboard:mixed

confirm-close-surface = true
