-- ─── Color Scheme ────────────────────────────────────────────────────────────

config.color_scheme = 'Tokyo Night'

-- ─── Background Image ────────────────────────────────────────────────────────
-- Each preset ties one image to the colour and blend that suit it: the solid
-- layer shows through the image, so they have to be chosen together.
--
-- `prefix + =` in tmux runs ~/.local/bin/wezterm-bg, which bumps the index in
-- the state file below. That file is on the config reload watch list, so
-- wezterm re-reads this config and repaints — no restart, no keybinding here.
--
-- Images live in backgrounds/ and are deliberately not tracked in chezmoi, so
-- a preset whose file is missing is skipped rather than pointing wezterm at a
-- path that doesn't exist. This table is the whole set: an image sitting in
-- backgrounds/ without an entry here is ignored, and an entry with no image at
-- all is a plain solid colour.

local bg_dir = wezterm.config_dir .. '/backgrounds'
local bg_state = (os.getenv 'XDG_CACHE_HOME' or (os.getenv 'HOME' .. '/.cache')) .. '/wezterm-bg/current'
wezterm.add_to_config_reload_watch_list(bg_state)

local presets = {
  -- 1
  {
    image = 'background.gif',
    color = '#0d1428', -- Tokyo Night navy
    opacity = 0.04,
    brightness = 0.90,
  },
  -- 2 — solid, no image
  {
    color = '#05050a',
  },
}

-- Preset every new wezterm process starts on, as the number in the comments
-- above. `prefix + =` cycles onward from here; the choice is not kept across
-- restarts. If that preset's image is missing, the first usable one is used.
local DEFAULT_PRESET = 1

local function readable(path)
  local f = io.open(path, 'r')
  if f then
    f:close()
    return true
  end
  return false
end

-- Drop presets whose image isn't on this machine.
local usable = {}
for _, preset in ipairs(presets) do
  if not preset.image or readable(bg_dir .. '/' .. preset.image) then
    usable[#usable + 1] = preset
  end
end
if #usable == 0 then
  usable = { { color = presets[1] and presets[1].color or '#0d1428' } }
end

-- DEFAULT_PRESET numbers the authored list, which may be longer than the usable
-- one; fall back to the first usable preset when the named one was skipped.
local default_index = 0
for i, preset in ipairs(usable) do
  if preset == presets[DEFAULT_PRESET] then
    default_index = i - 1
    break
  end
end

local function read_bg_index()
  local f = io.open(bg_state, 'r')
  if not f then
    return nil
  end
  local n = tonumber((f:read '*a' or ''):match '%d+')
  f:close()
  return n
end

local function write_bg_index(n)
  local f = io.open(bg_state, 'w')
  if not f then
    -- First run on this machine: wezterm-bg hasn't created the cache dir yet.
    os.execute("mkdir -p '" .. bg_state:gsub('/[^/]*$', '') .. "'")
    f = io.open(bg_state, 'w')
    if not f then
      return
    end
  end
  f:write(tostring(n))
  f:close()
end

-- This config is re-evaluated on every reload, so distinguish the first
-- evaluation in this process from later ones: wezterm.GLOBAL lives as long as
-- the process does. On launch, pin DEFAULT_PRESET and persist it so wezterm-bg
-- cycles onward from there rather than from whatever the last session left.
local bg_index
if wezterm.GLOBAL.bg_launched then
  bg_index = read_bg_index() or default_index
else
  wezterm.GLOBAL.bg_launched = true
  bg_index = default_index
  -- Only write when it differs — writing trips the watcher and costs a reload.
  if read_bg_index() ~= bg_index then
    write_bg_index(bg_index)
  end
end

local bg = usable[(bg_index % #usable) + 1]

config.background = {
  {
    source = { Color = bg.color },
    width = '100%',
    height = '100%',
  },
}

if bg.image then
  table.insert(config.background, {
    source = { File = bg_dir .. '/' .. bg.image },
    -- Without an explicit size the image draws at its native resolution and
    -- leaves the solid layer showing around it. Stretch it to the window.
    width = '100%',
    height = '100%',
    horizontal_align = 'Center',
    vertical_align = 'Middle',
    opacity = bg.opacity or 0.04,
    hsb = { brightness = bg.brightness or 0.9 },
  })
end

