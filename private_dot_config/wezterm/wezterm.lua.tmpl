local wezterm = require 'wezterm'
local act = wezterm.action
local config = wezterm.config_builder()

{{ if eq .chezmoi.os "darwin" -}}
local inherited_path = os.getenv 'PATH' or '/usr/bin:/bin:/usr/sbin:/sbin'
config.set_environment_variables = {
  PATH = '/opt/homebrew/bin:' .. inherited_path,
}
config.default_prog = { '/opt/homebrew/bin/tmux', 'new-session', '-A', '-s', 'main' }
{{- else -}}
config.default_prog = { '/home/linuxbrew/.linuxbrew/bin/tmux', 'new-session', '-A', '-s', 'main' }
{{- end }}

-- ─── Font ────────────────────────────────────────────────────────────────────

config.font = wezterm.font_with_fallback {
  { family = 'JetBrains Mono', weight = 'Medium' },
  { family = 'Fira Code', weight = 'Medium' },
  -- Nerd Font glyphs (statusline icons, devicons) live in the Private Use Area,
  -- which the fonts above don't cover. Installed at ~/Library/Fonts.
  { family = 'JetBrainsMono Nerd Font', weight = 'Medium' },
  'Noto Color Emoji',
}
config.font_size = 13.0
config.line_height = 1.15
config.harfbuzz_features = { 'calt', 'liga', 'dlig' }

-- ─── Color Scheme ────────────────────────────────────────────────────────────

config.color_scheme = 'Tokyo Night'

-- ─── Background Image ────────────────────────────────────────────────────────
-- Each preset ties one image to the colour and blend that suit it: the solid
-- layer shows through the image, so they have to be chosen together.
--
-- `prefix + =` in tmux runs ~/.local/bin/wezterm-bg, which bumps the index in
-- the state file below. That file is on the config reload watch list, so
-- wezterm re-reads this config and repaints — no restart, no keybinding here.
--
-- Images live in backgrounds/ and are deliberately not tracked in chezmoi, so
-- a preset whose file is missing is skipped rather than pointing wezterm at a
-- path that doesn't exist. This table is the whole set: an image sitting in
-- backgrounds/ without an entry here is ignored, and an entry with no image at
-- all is a plain solid colour.

local bg_dir = wezterm.config_dir .. '/backgrounds'
local bg_state = (os.getenv 'XDG_CACHE_HOME' or (os.getenv 'HOME' .. '/.cache')) .. '/wezterm-bg/current'
wezterm.add_to_config_reload_watch_list(bg_state)

-- `max_fps` is per preset: an animated background is recomposited at the render
-- rate, so the heavy ones are worth capping while a solid colour costs nothing
-- and can run as fast as the display. It's a global wezterm setting, but
-- switching presets re-evaluates this whole config, so it gets re-applied.
local MAX_FPS = 60 -- fallback for presets that don't set one

local presets = {
  -- 1 — car. 1280x720, 334 frames, 56MB, downscaled from a 1920x1080 205MB
  -- original with `gifsicle --resize-fit 1280x720 --optimize=3 --lossy=80`.
  --
  -- The base colour carries the tint: at opacity 0.12 the image contributes
  -- little, so ~88% of what you see is this layer. Hence a dark amber rather
  -- than a bright orange, which would wash out the foreground text. Dial it up
  -- with #2a1405 (warmer) or #3d1d06 (strongest still readable).
  {
    image = 'car.gif',
    color = '#1a0d03',
    opacity = 0.06,
    brightness = 0.85,
    saturation = 1.20, -- push the gif's own warm tones
    max_fps = 60,
  },
  -- 2
  {
    image = 'background.gif',
    color = '#0d1428', -- Tokyo Night navy
    opacity = 0.04,
    brightness = 0.90,
    max_fps = 60,
  },
  -- 3 — background1. 1280x682, 140 frames, 18MB, downscaled from 2028x1080 /
  -- 49MB with `gifsicle --resize-fit 1280x720 --optimize=3 --lossy=80`. Runs at
  -- 33fps, so it is the busiest of the three. Base colour is derived from the
  -- image's own average (#938575, a warm neutral), darkened for text contrast.
  {
    image = 'background1.gif',
    color = '#241f1a',
    opacity = 0.06,
    brightness = 0.85,
    saturation = 1.10,
    max_fps = 60,
  },
  -- 4 — solid, no image. Cheapest: nothing to decode or recomposite.
  {
    color = '#05050a',
    max_fps = 120,
  },
}

-- Preset every new wezterm process starts on, as the number in the comments
-- above. `prefix + =` cycles onward from here; the choice is not kept across
-- restarts. If that preset's image is missing, the first usable one is used.
local DEFAULT_PRESET = 1

local function readable(path)
  local f = io.open(path, 'r')
  if f then
    f:close()
    return true
  end
  return false
end

-- Drop presets whose image isn't on this machine.
local usable = {}
for _, preset in ipairs(presets) do
  if not preset.image or readable(bg_dir .. '/' .. preset.image) then
    usable[#usable + 1] = preset
  end
end
if #usable == 0 then
  usable = { { color = presets[1] and presets[1].color or '#0d1428' } }
end

-- DEFAULT_PRESET numbers the authored list, which may be longer than the usable
-- one; fall back to the first usable preset when the named one was skipped.
local default_index = 0
for i, preset in ipairs(usable) do
  if preset == presets[DEFAULT_PRESET] then
    default_index = i - 1
    break
  end
end

local function read_bg_index()
  local f = io.open(bg_state, 'r')
  if not f then
    return nil
  end
  local n = tonumber((f:read '*a' or ''):match '%d+')
  f:close()
  return n
end

local function write_bg_index(n)
  local f = io.open(bg_state, 'w')
  if not f then
    -- First run on this machine: wezterm-bg hasn't created the cache dir yet.
    os.execute("mkdir -p '" .. bg_state:gsub('/[^/]*$', '') .. "'")
    f = io.open(bg_state, 'w')
    if not f then
      return
    end
  end
  f:write(tostring(n))
  f:close()
end

-- This config is re-evaluated on every reload, so distinguish the first
-- evaluation in this process from later ones: wezterm.GLOBAL lives as long as
-- the process does. On launch, pin DEFAULT_PRESET and persist it so wezterm-bg
-- cycles onward from there rather than from whatever the last session left.
local bg_index
if wezterm.GLOBAL.bg_launched then
  bg_index = read_bg_index() or default_index
else
  wezterm.GLOBAL.bg_launched = true
  bg_index = default_index
  -- Only write when it differs — writing trips the watcher and costs a reload.
  if read_bg_index() ~= bg_index then
    write_bg_index(bg_index)
  end
end

local bg = usable[(bg_index % #usable) + 1]

config.max_fps = bg.max_fps or MAX_FPS

config.background = {
  {
    source = { Color = bg.color },
    width = '100%',
    height = '100%',
  },
}

if bg.image then
  table.insert(config.background, {
    source = { File = bg_dir .. '/' .. bg.image },
    -- Without an explicit size the image draws at its native resolution and
    -- leaves the solid layer showing around it. Stretch it to the window.
    width = '100%',
    height = '100%',
    horizontal_align = 'Center',
    vertical_align = 'Middle',
    opacity = bg.opacity or 0.04,
    -- All three are multipliers against the source, so 1.0 is untouched.
    hsb = {
      brightness = bg.brightness or 0.9,
      saturation = bg.saturation or 1.0,
      hue = bg.hue or 1.0,
    },
  })
end

-- ─── Window ──────────────────────────────────────────────────────────────────

-- Transparency costs something: the compositor blends the desktop behind every
-- frame, and the default background is animated. 0.80 is about as low as the
-- #c0caf5 foreground stays comfortable over a busy desktop.
config.window_background_opacity = 0.85
-- Blurs whatever is behind the window, so transparency reads as depth instead
-- of the desktop competing with the text. Native macOS effect; no-op elsewhere.
config.macos_window_background_blur = 25
config.window_padding = {
  left = 12,
  right = 12,
  top = 8,
  bottom = 4,
}
config.initial_cols = 140
config.initial_rows = 38
config.window_decorations = 'RESIZE'
config.window_close_confirmation = 'AlwaysPrompt'
config.adjust_window_size_when_changing_font_size = false

