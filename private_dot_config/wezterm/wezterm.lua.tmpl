  { family = 'JetBrains Mono', weight = 'Medium' },
  { family = 'Fira Code', weight = 'Medium' },
  -- Nerd Font glyphs (statusline icons, devicons) live in the Private Use Area,
  -- which the fonts above don't cover. Installed at ~/Library/Fonts.
  { family = 'JetBrainsMono Nerd Font', weight = 'Medium' },
