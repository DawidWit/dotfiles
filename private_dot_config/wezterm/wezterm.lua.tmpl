local DEFAULT_PRESET = 1

local function readable(path)
  local f = io.open(path, 'r')
  if f then
    f:close()
    return true
  end
  return false
end

local function write_bg_state(path, value)
  local state_dir = path:gsub('/[^/]*$', '')
  os.execute("mkdir -p '" .. state_dir .. "'")

  local temporary_path = path .. '.tmp'
  local f = io.open(temporary_path, 'w')
  if not f then
    return false
  end
  f:write(tostring(value))
  f:close()
  return os.rename(temporary_path, path)
end

local usable = {}
for _, preset in ipairs(presets) do
  if not preset.image or readable(bg_dir .. '/' .. preset.image) then
    usable[#usable + 1] = preset
  end
end
if #usable == 0 then
  usable = { { color = presets[1] and presets[1].color or '#0d1428' } }
end
write_bg_state(bg_state_dir .. '/count', #usable)

local default_index = 0
for i, preset in ipairs(usable) do
  if preset == presets[DEFAULT_PRESET] then
    default_index = i - 1
    break
  end
end

local function read_bg_index()
  local f = io.open(bg_state, 'r')
  if not f then
    return nil
  end
  local n = tonumber((f:read '*a' or ''):match '%d+')
  f:close()
  return n
end

local function write_bg_index(n)
  write_bg_state(bg_state, n)
end

local bg_index
if wezterm.GLOBAL.bg_launched then
  bg_index = read_bg_index() or default_index
else
  wezterm.GLOBAL.bg_launched = true
  bg_index = default_index
  if read_bg_index() ~= bg_index then
    write_bg_index(bg_index)
  end
end

