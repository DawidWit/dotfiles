{{- if eq (env "DOTFILES_BOOTSTRAP_EXTERNALS") "1" }}
[".tmux/plugins/tpm"]
    type = "archive"
    url = "https://github.com/tmux-plugins/tpm/archive/refs/tags/v3.1.0.tar.gz"
    exact = true
    stripComponents = 1

# Zellij status bar plugin, loaded by .config/zellij/layouts/ai-ultrawide.kdl.
[".config/zellij/plugins/zjstatus.wasm"]
    type = "file"
    url = "https://github.com/dj95/zjstatus/releases/download/v0.25.0/zjstatus.wasm"
{{- end }}
